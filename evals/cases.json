{
  "schema_version": 1,
  "cases": [
    {
      "id": "normal_tool_execution",
      "description": "A valid tool_use executes once and its result is returned to the model.",
      "approval": "auto",
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "call-normal",
              "name": "record",
              "input": {"value": "safe"}
            }
          ]
        },
        {
          "stop_reason": "end_turn",
          "content": [{"type": "text", "text": "completed"}]
        }
      ],
      "expect": {
        "stop_reason": "end_turn",
        "final_text": "completed",
        "side_effects": [{"value": "safe"}],
        "approval_requests": [],
        "provider_requests": 2,
        "history_roles": ["user", "assistant", "user", "assistant"],
        "tool_results": [
          {"tool_use_id": "call-normal", "is_error": false}
        ]
      }
    },
    {
      "id": "max_tokens_blocks_side_effect",
      "description": "A tool call embedded in a max_tokens response is paired but never dispatched.",
      "approval": "auto",
      "turns": [
        {
          "stop_reason": "max_tokens",
          "content": [
            {
              "type": "tool_use",
              "id": "call-truncated",
              "name": "record",
              "input": {"value": "must-not-run"}
            }
          ]
        }
      ],
      "expect": {
        "stop_reason": "max_tokens",
        "final_text": "",
        "side_effects": [],
        "approval_requests": [],
        "provider_requests": 1,
        "history_roles": ["user", "assistant", "user"],
        "tool_results": [
          {"tool_use_id": "call-truncated", "is_error": true}
        ]
      }
    },
    {
      "id": "budget_blocks_side_effect",
      "description": "Usage that exhausts the run budget blocks a pending side effect before dispatch.",
      "approval": "auto",
      "limits": {"max_budget_usd": "0.000001"},
      "pricing": {"input_price": 1.0, "output_price": 1.0},
      "turns": [
        {
          "stop_reason": "tool_use",
          "usage": {"input_tokens": 10, "output_tokens": 5},
          "content": [
            {
              "type": "tool_use",
              "id": "call-over-budget",
              "name": "record",
              "input": {"value": "must-not-run"}
            }
          ]
        }
      ],
      "expect": {
        "stop_reason": "budget_exceeded",
        "final_text": "",
        "side_effects": [],
        "approval_requests": [],
        "provider_requests": 1,
        "history_roles": ["user", "assistant", "user"],
        "tool_results": [
          {"tool_use_id": "call-over-budget", "is_error": true}
        ]
      }
    },
    {
      "id": "duplicate_tool_call_id_not_executed",
      "description": "Duplicate tool_use IDs reject the whole assistant turn without dispatch.",
      "approval": "auto",
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "duplicate",
              "name": "record",
              "input": {"value": "first"}
            },
            {
              "type": "tool_use",
              "id": "duplicate",
              "name": "record",
              "input": {"value": "second"}
            }
          ]
        }
      ],
      "expect": {
        "stop_reason": "error",
        "final_text": "",
        "side_effects": [],
        "approval_requests": [],
        "provider_requests": 1,
        "history_roles": ["user"],
        "tool_results": []
      }
    },
    {
      "id": "parallel_read_only_probes_execute_without_approval",
      "description": "A batch of read-only tools runs in parallel and bypasses ask-mode approval.",
      "approval": "ask",
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "probe-1",
              "name": "probe",
              "input": {"probe": "one"}
            },
            {
              "type": "tool_use",
              "id": "probe-2",
              "name": "probe",
              "input": {"probe": "two"}
            }
          ]
        },
        {
          "stop_reason": "end_turn",
          "content": [{"type": "text", "text": "parallel done"}]
        }
      ],
      "expect": {
        "stop_reason": "end_turn",
        "final_text": "parallel done",
        "side_effects": [{"probe": "one"}, {"probe": "two"}],
        "approval_requests": [],
        "provider_requests": 2,
        "history_roles": ["user", "assistant", "user", "assistant"],
        "tool_results": [
          {"tool_use_id": "probe-1", "is_error": false},
          {"tool_use_id": "probe-2", "is_error": false}
        ]
      }
    },
    {
      "id": "unknown_tool_reports_error_and_continues",
      "description": "A call to an unregistered tool pairs an error result and the loop continues.",
      "approval": "auto",
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "call-missing",
              "name": "missing",
              "input": {}
            }
          ]
        },
        {
          "stop_reason": "end_turn",
          "content": [{"type": "text", "text": "recovered from unknown tool"}]
        }
      ],
      "expect": {
        "stop_reason": "end_turn",
        "final_text": "recovered from unknown tool",
        "side_effects": [],
        "approval_requests": [],
        "provider_requests": 2,
        "history_roles": ["user", "assistant", "user", "assistant"],
        "tool_results": [
          {"tool_use_id": "call-missing", "is_error": true}
        ]
      }
    },
    {
      "id": "cancel_mid_batch_pairs_remaining_calls",
      "description": "Cancellation between serial calls pairs the remaining calls as errors without dispatch.",
      "approval": "auto",
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "call-cancelling",
              "name": "record",
              "input": {"value": "first", "cancel": true}
            },
            {
              "type": "tool_use",
              "id": "call-after-cancel",
              "name": "record",
              "input": {"value": "second"}
            }
          ]
        }
      ],
      "expect": {
        "stop_reason": "interrupted",
        "final_text": "",
        "side_effects": [{"value": "first", "cancel": true}],
        "approval_requests": [],
        "provider_requests": 1,
        "history_roles": ["user", "assistant", "user"],
        "tool_results": [
          {"tool_use_id": "call-cancelling", "is_error": false},
          {"tool_use_id": "call-after-cancel", "is_error": true}
        ]
      }
    },
    {
      "id": "approval_grant_executes_side_effect",
      "description": "A granted write approval executes the tool exactly once.",
      "approval": "ask",
      "approval_decisions": [true],
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "call-approved",
              "name": "record",
              "input": {"value": "approved"}
            }
          ]
        },
        {
          "stop_reason": "end_turn",
          "content": [{"type": "text", "text": "approval honoured"}]
        }
      ],
      "expect": {
        "stop_reason": "end_turn",
        "final_text": "approval honoured",
        "side_effects": [{"value": "approved"}],
        "approval_requests": ["record"],
        "provider_requests": 2,
        "history_roles": ["user", "assistant", "user", "assistant"],
        "tool_results": [
          {"tool_use_id": "call-approved", "is_error": false}
        ]
      }
    },
    {
      "id": "approval_denial_blocks_side_effect",
      "description": "A denied write approval produces an error result without executing the tool.",
      "approval": "ask",
      "approval_decisions": [false],
      "turns": [
        {
          "stop_reason": "tool_use",
          "content": [
            {
              "type": "tool_use",
              "id": "call-denied",
              "name": "record",
              "input": {"value": "must-not-run"}
            }
          ]
        },
        {
          "stop_reason": "end_turn",
          "content": [{"type": "text", "text": "denial handled"}]
        }
      ],
      "expect": {
        "stop_reason": "end_turn",
        "final_text": "denial handled",
        "side_effects": [],
        "approval_requests": ["record"],
        "provider_requests": 2,
        "history_roles": ["user", "assistant", "user", "assistant"],
        "tool_results": [
          {"tool_use_id": "call-denied", "is_error": true}
        ]
      }
    }
  ]
}
